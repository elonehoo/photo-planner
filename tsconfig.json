{
  "compilerOptions": {
    "target": "es2016",
    "jsx": "preserve",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "paths": {
      "~components/*": [
        "./src/components/*"
      ],
      "~styles/*": [
        "./src/styles/*"
      ],
      "~/*": [
        "./src/*"
      ],
      "~composition/*": [
        "./src/composition/*"
      ]
    },
    "resolveJsonModule": true,
    "types": [
      "vite/client",
      "vitest/globals"
    ],
    "strict": true,
    "strictNullChecks": true,
    "noUnusedLocals": true,
    "noEmit": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.vue",
    "test/**/*.ts",
    "*.d.ts"
  ],
  "exclude": [
    "dist",
    "node_modules"
  ]
}
