{
  "type": "module",
  "version": "0.0.0",
  "private": "true",
  "packageManager": "pnpm@12.16.1",
  "description": "Photo post planner.",
  "author": "Elone Hoo <hi@elonehoo.me>",
  "license": "MIT",
  "vite": {
    "server": {
      "port": 3333
    },
    "test": {
      "environment": "happy-dom",
      "globals": true
    }
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --port 8766",
    "test": "vitest",
    "test:ui": "vitest --ui --open false",
    "test:coverage": "vitest run --coverage",
    "typecheck": "node --require ./scripts/typescript6-resolve.cjs ./node_modules/vue-tsc/bin/vue-tsc.js --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "node --require ./scripts/typescript6-resolve.cjs ./node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node --require ./scripts/typescript6-resolve.cjs ./node_modules/eslint/bin/eslint.js . --fix",
    "release": "bumpp package.json --commit --push --tag"
  },
  "dependencies": {
    "@unocss/reset": "^66.12.0",
    "@vueuse/core": "^15.0.0",
    "@vueuse/head": "^2.0.0",
    "chroma-js": "^3.2.0",
    "file-saver": "^2.0.5",
    "html2canvas": "^1.4.1",
    "mobile-drag-drop": "3.0.0-rc.0",
    "unocss": "^66.12.0",
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.5.1",
    "@iconify-json/carbon": "^1.2.29",
    "@iconify-json/mdi-light": "^1.2.2",
    "@types/chroma-js": "^3.1.3",
    "@types/file-saver": "^2.0.7",
    "@types/node": "^24.19.2",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vitest/coverage-v8": "^5.0.5",
    "@vitest/ui": "^5.0.5",
    "@vue/test-utils": "^2.5.1",
    "bumpp": "^12.3.0",
    "eslint": "^10.13.0",
    "happy-dom": "^21.0.4",
    "typescript": "^7.0.2",
    "unplugin-auto-import": "^21.1.0",
    "unplugin-deploy-info": "^0.0.3",
    "unplugin-vue-components": "^32.1.0",
    "vite": "^8.3.5",
    "vite-plugin-chai": "^0.0.2",
    "vite-plugin-classify": "^0.0.1",
    "vite-plugin-package-configs": "^0.0.12",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.14"
  }
}
